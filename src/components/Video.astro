---
// A narrated screen recording: it plays, with its sound, only when the reader
// presses play, has controls, and stays inline on a phone. It offers English
// captions of the narration, off until the reader turns them on. Files:
// public/media/<name>.webm, a still from it as <name>-poster.png, and the
// captions as <name>.vtt (src/data/media.ts).
import type { Video } from '../data/media';
interface Props { video: Video }
const { video } = Astro.props;
---
<figure class="video">
  <video controls playsinline preload="none" width={video.w} height={video.h} poster={`/media/${video.name}-poster.png`} aria-label={video.label}>
    <source src={`/media/${video.name}.webm`} type="video/webm" />
    <track kind="captions" srclang="en" label="English" src={`/media/${video.name}.vtt`} />
  </video>
  <figcaption>{video.label}</figcaption>
</figure>

<style>
  .video { margin: 24px 0 0; max-width: 920px; }
  .video video { display: block; width: 100%; height: auto; border: 1px solid var(--rule); border-radius: 12px; background: var(--paper-2); }
  .video figcaption { font-size: 15px; color: var(--ink-soft); margin-top: 8px; }
</style>
