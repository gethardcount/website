---
// A silent screen recording: it plays only when the reader presses play, has
// controls, and stays inline on a phone. Files: public/media/<name>.webm and
// its first frame, public/media/<name>-poster.png (src/data/media.ts).
import type { Video } from '../data/media';
interface Props { video: Video }
const { video } = Astro.props;
---
<figure class="video">
  <video controls muted playsinline preload="none" width={video.w} height={video.h} poster={`/media/${video.name}-poster.png`} aria-label={video.label}>
    <source src={`/media/${video.name}.webm`} type="video/webm" />
  </video>
  <figcaption>{video.label}</figcaption>
</figure>

<style>
  .video { margin: 24px 0 0; max-width: 920px; }
  .video video { display: block; width: 100%; height: auto; border: 1px solid var(--rule); border-radius: 12px; background: var(--paper-2); }
  .video figcaption { font-size: 15px; color: var(--ink-soft); margin-top: 8px; }
</style>
