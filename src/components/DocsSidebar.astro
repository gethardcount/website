---
// On a phone the docs header hides the site menu, so the docs menu shows it
// first, above the docs sidebar.
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { NAV } from '../site';
---
<nav class="hc-mobile-nav" aria-label="Site">
  {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
</nav>
<Default />

<style>
  .hc-mobile-nav { display: flex; flex-wrap: wrap; gap: 0 1.25rem; padding: 0 0 0.5rem; margin-bottom: 1rem; border-bottom: 1px solid var(--sl-color-hairline-shade); }
  /* Each link is a 44px-tall tap target. */
  .hc-mobile-nav a { color: var(--sl-color-white); text-decoration: none; font-weight: 500; display: inline-flex; align-items: center; min-height: 44px; }
  @media (min-width: 1100px) { .hc-mobile-nav { display: none; } }
</style>
