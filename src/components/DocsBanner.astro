---
// The same status line as the website pages, on every docs page.
import StatusLine from './StatusLine.astro';
---
<div class="hc-status" data-pagefind-ignore><StatusLine /></div>

<style>
  .hc-status { padding: 0.5rem var(--sl-content-pad-x, 1.5rem); font-size: 0.85rem; color: var(--sl-color-gray-3); background: var(--sl-color-gray-7, var(--sl-color-gray-6)); border-bottom: 1px solid var(--sl-color-hairline-shade); }
  .hc-status :global(a) { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .hc-status :global(a:hover) { color: var(--sl-color-accent-high); }
</style>
