---
import Base from '../layouts/Base.astro';
import { failures } from '../data/failures';
import { doc, DISCUSSIONS, CONTACT_EMAIL } from '../site';



// Why choose it over the alternatives. What it does lives on /product.
const gets = [
  { lead: 'No Stripe Billing fee.', rest: 'Stripe charges the card at its normal fee. Hardcount takes nothing on what you bill.', link: ['Pricing', '/pricing/'] },
  { lead: 'Every model on one meter.', rest: 'Each model and token type gets its own price, on one meter.', link: ['Price per model', '/product/#pricing'] },
  { lead: 'One free edition.', rest: 'MIT, with no paid edition: every feature is in the same code.', link: ['Pricing', '/pricing/'] },
  { lead: 'Light to run.', rest: 'One Go program and Postgres, plus Redis for rate limits, on your own servers.', link: ['Self-host', '/docs/self-host/overview/'] },
];


---
<Base
  title="Hardcount: open-source alternative to Stripe Billing and Lago for AI billing"
  description="Open-source usage billing for AI products, on your own servers. Price tokens per model, sell prepaid credit, and see what each customer costs you."
>
  <section class="hero">
    <div class="wrap">
      <h1>Usage billing for AI products, <span class="accent">on your own servers.</span></h1>
      <p class="lede prose">Price tokens per model, sell prepaid credit, and see what each customer costs you. Hardcount makes the invoices, and Stripe charges the card.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/docs/get-started/quick-start/">Run it locally</a>
        <a class="btn btn-quiet" href={DISCUSSIONS}>Talk to the maintainer</a>
      </div>
      <p class="small muted prose under">
        Free and open source (MIT). Try it before you trust it: the demo runs on your computer in test mode, where no real money moves.
        Questions go to Sagar, the one maintainer, by <a href={`mailto:${CONTACT_EMAIL}`}>email</a> or <a href={DISCUSSIONS}>GitHub Discussions</a>.
      </p>
    </div>
  </section>

  <section id="looks">
    <div class="wrap">
      <h2>What it looks like</h2>
      <p class="prose muted">One month of AI usage for one customer, from the <a href="#try">demo</a> in test mode. Its dates follow the demo’s test clock, a month ahead.</p>
      <div class="shots">
        <figure>
          <figcaption><strong>The demo invoice.</strong> One line per model and token type, priced per million tokens.</figcaption>
          <a href="/shots/invoice-light.png" class="shot-link" title="Open full size">
          <picture>
            <source media="(prefers-color-scheme: dark)" srcset="/shots/invoice-dark.png" />
            <img src="/shots/invoice-light.png" width="1400" height="1500" loading="lazy" alt="Invoice HC-000001 in the Hardcount dashboard: input, output and cache_read lines for claude-sonnet-4.5 and input and output lines for claude-haiku-4.5, priced per 1M tokens, $5.73 due." />
          </picture>
          </a>
        </figure>
        <figure>
          <figcaption><strong>Your margin, per model.</strong> Each model's usage revenue against what the AI provider charged you: Sonnet 67.1%, Haiku 20.0%. Only you see this.</figcaption>
          <a href="/shots/margin-light.png" class="shot-link" title="Open full size">
          <picture>
            <source media="(prefers-color-scheme: dark)" srcset="/shots/margin-dark.png" />
            <img src="/shots/margin-light.png" width="1400" height="507" loading="lazy" alt="The Margin card for the demo customer: $5.73 usage billed, $2.76 provider cost, 51.9% margin, with claude-sonnet-4.5 at 67.1% and claude-haiku-4.5 at 20.0%." />
          </picture>
          </a>
        </figure>
      </div>
    </div>
  </section>

  <section id="gets">
    <div class="wrap">
      <h2>What you get</h2>
      <p class="prose muted">Hardcount is an open-source alternative to Stripe Billing and Lago.</p>
      <ul class="gets">
        {gets.map((g) => <li><strong>{g.lead}</strong> {g.rest} <a href={g.link[1]}>{g.link[0]} →</a></li>)}
      </ul>
      <p class="small">
        Everything it does: <a href="/product/">Product →</a><br />
        How it compares, including where others are ahead: <a href="/compare/">Compare →</a>
      </p>
    </div>
  </section>

  <section id="why">
    <div class="wrap">
      <h2>Why Hardcount</h2>
      <p class="prose big">A usage bill looks like arithmetic: count what each customer used, multiply by the price, charge the card. The real work is in what can go wrong.</p>
      <div class="cards">
        {failures.map((c) => (
          <a class="card case" href={`/reliability/#${c.id}`}>
            <h3>“{c.title}”</h3>
            <p>{c.short}</p>
            <span class="more">How it works →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="fit">
    <div class="wrap">
      <h2>Is it right for you?</h2>
      <div class="two">
        <div>
          <h3>A good fit if</h3>
          <ul>
            <li>You charge by usage, especially for an AI product priced per token.</li>
            <li>You want billing on your own servers, with usage and invoices in your own Postgres.</li>
            <li>You are comfortable running a server, Postgres and Redis yourself.</li>
          </ul>
        </div>
        <div>
          <h3>Not a fit if you need</h3>
          <ul>
            <li>Simple per-seat pricing paid by card. Stripe Billing already does that well.</li>
            <li>A payment processor other than Stripe.</li>
            <li>Marketplace payouts split between sellers.</li>
            <li>Revenue recognition or accounting reports.</li>
            <li>Quotes or multi-phase contracts for sales-led deals.</li>
            <li>A customer portal. Customers pay on a hosted invoice page instead.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <h2>How it works</h2>
      <ol class="steps">
        <li><strong>Your app sends usage.</strong> One event for each thing you count, such as the tokens of one AI call. A <a href={doc('integrations/litellm.md')}>LiteLLM proxy</a> can send them for you.</li>
        <li><strong>Hardcount prices it.</strong> It uses your plan’s prices, and at the end of each billing period it makes the invoice and its PDF.</li>
        <li><strong>Stripe charges the card.</strong> If a charge fails, Hardcount retries on a schedule and, once email is set up, emails your customer. The subscription doesn’t switch to “past due”: your app decides when to limit access.</li>
      </ol>
      <p class="prose">One usage event, sent with curl:</p>
      <pre><code>curl -X POST http://localhost:8080/v1/usage-events \
  -H "Authorization: Bearer $HARDCOUNT_KEY" \
  -H "Content-Type: application/json" \
  -d '&#123;"event_name": "tokens",
       "external_customer_id": "acme",
       "quantity": 1200,
       "dimensions": &#123;"model": "claude-sonnet-4.5", "token_type": "input"&#125;,
       "idempotency_key": "req-42:input"&#125;'</code></pre>
      <p class="prose">There are no SDKs yet. <a href={doc('first-invoice.md')}>Your first invoice, step by step →</a> does every request with curl.</p>
    </div>
  </section>

  <section id="try">
    <div class="wrap">
      <h2>Run it locally</h2>
      <p class="prose">This starts Hardcount on your computer in test mode and runs a demo. You need git and Docker 24 or newer, with Compose. On Windows, use WSL.</p>
      <pre><code>git clone https://github.com/gethardcount/hardcount.git
cd hardcount/deploy/compose
./quickstart.sh
./quickstart.sh demo</code></pre>
      <p class="prose"><code>./quickstart.sh</code> prints your dashboard address and sign-in, and saves them in <code>quickstart-credentials.json</code>. The demo then sets prices for AI tokens, sends a customer’s token usage the way LiteLLM does, moves a test clock to the end of the month, and makes the invoice, its PDF and your margin report.</p>
      <p class="prose">The demo ends like this, with links to open in the dashboard:</p>
      <pre class="out"><code>━━━ Done: every step above ran and was checked ━━━

  <span class="ok">✓</span> One call loaded a price for each model and token type
  <span class="ok">✓</span> LiteLLM-shaped calls to two models became usage events, with no SDK
  <span class="ok">✓</span> Hardcount recorded what each usage event cost you
  <span class="ok">✓</span> A test clock moved one month, and Hardcount made the invoice and its PDF
  <span class="ok">✓</span> Your margin on this customer, by model

    Invoice:  http://localhost:8080/invoices/hc_inv_…
    Customer: http://localhost:8080/customers/hc_cus_…</code></pre>
      <p class="prose">Done? <code>./quickstart.sh stop</code> keeps your data. <code>./quickstart.sh destroy</code> deletes it.</p>
      <p class="small">
        The full walkthrough, and where to click: <a href={doc('quick-start.md')}>Quick start →</a>
      </p>
    </div>
  </section>

  <section id="more">
    <div class="wrap">
      <ul class="more-list">
        <li><strong>Running it for real:</strong> one VM with Docker Compose, or two or more copies behind a load balancer. <a href={doc('self-host.md')}>Self-host →</a></li>
        <li><strong>What it costs:</strong> Hardcount is free; you pay for your server and Stripe’s card fee. <a href="/pricing/">Pricing →</a></li>
        <li><strong>What’s next:</strong> spend alerts and SDKs for Go and TypeScript in v0.10. <a href={doc('roadmap.md')}>Roadmap →</a></li>
        <li><strong>Questions?</strong> Lock-in, safety for real money, who maintains it. <a href="/faq/">FAQ →</a></li>
      </ul>
    </div>
  </section>

  <section class="end">
    <div class="wrap">
      <h2>Try it on your computer</h2>
      <p class="prose muted">Start Hardcount in test mode and run its demo. Found something rough? Open an issue or a Discussion.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/docs/get-started/quick-start/">Run it locally</a>
        <a class="btn btn-quiet" href={DISCUSSIONS}>Talk to the maintainer</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 88px; }
  .accent { color: var(--copper); }
  .lede { font-size: 21px; margin-top: 8px; color: var(--ink-soft); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .under { margin-top: 18px; }
  .big { font-size: 20px; }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 28px; }
  .card h3 { font-size: 20px; }
  .card p { font-size: 16px; }
  .card { display: flex; flex-direction: column; }
  .card > a { margin-top: auto; }
  .case { text-decoration: none; color: inherit; }
  .case:hover { border-color: var(--copper); }
  .case .more { margin-top: auto; color: var(--copper-ink); font-size: 15px; }
  .card a { font-size: 15px; }

  .gets { list-style: none; padding: 0; margin: 24px 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 40px; }
  .gets li { padding-left: 20px; position: relative; font-size: 17px; }
  .gets li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 9px; height: 9px; border-radius: 2px; background: var(--copper); }

  .shots { display: grid; grid-template-columns: 1.1fr 1fr; gap: 32px; align-items: start; margin-top: 24px; }
  .shots figure { margin: 0; }
  .shots figcaption { font-size: 16px; color: var(--ink-soft); margin-bottom: 12px; }
  .shots figcaption strong { color: var(--ink); }
  .shot-link { display: block; }
  .shots img { display: block; width: 100%; height: auto; border: 1px solid var(--rule); border-radius: 12px; box-shadow: 0 2px 14px rgb(34 29 24 / 0.08); }

  .out { font-size: 13.5px; }
  .out .ok { color: #3F8F4E; }

  .steps { padding-left: 22px; max-width: var(--text); }
  .steps li { margin-bottom: 12px; }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .two ul { padding-left: 20px; }
  .two li { margin-bottom: 8px; }

  .plain { padding-left: 20px; }
  .plain li { margin-bottom: 12px; }

  .more-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .more-list li { font-size: 17px; }
  .faq details { border-bottom: 1px solid var(--rule); padding: 14px 0; }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq details p { margin: 10px 0 0; color: var(--ink-soft); }

  .end { text-align: left; }

  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr; }
    .gets { grid-template-columns: 1fr; }
    .shots { grid-template-columns: 1fr; }
    .two { grid-template-columns: 1fr; gap: 8px; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 48px; }
    .lede { font-size: 19px; }
  }
</style>
