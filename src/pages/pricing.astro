---
import Base from '../layouts/Base.astro';
import TryIt from '../components/TryIt.astro';
import { doc, START_HERE, CONTACT_EMAIL } from '../site';

// Stripe's figures, checked on 2026-10-31: Billing's pay-as-you-go fee is
// 0.7% of billing volume (stripe.com/billing/pricing), and the card fee for a
// domestic US card is 2.9% + 30¢ (stripe.com/pricing).
const volumes = [10_000, 100_000, 1_000_000];
const usd = (n: number) => '$' + n.toLocaleString('en-US');
---
<Base title="Hardcount pricing: free and open source" description="Hardcount is free and MIT-licensed, with no paid edition and no fee on what you bill. Your costs are your server and Stripe's card fee.">
  <section class="top">
    <div class="wrap prose">
      <h1>Free. No paid edition, no fee on what you bill.</h1>
      <p class="lede">Hardcount is MIT-licensed. Every feature is in the one edition. There is no cloud version, no licence key and no share of your revenue.</p>
    </div>
  </section>

  <section>
    <div class="wrap prose">
      <h2>What you pay for</h2>
      <ul class="plain">
        <li><strong>Your server.</strong> One server listed at €6.49 a month before VAT in October 2026 (2 shared CPUs, 4 GB memory) handled 12 usage events a second, with bursts to 60, for 20 minutes. It had no errors, and its CPU was 12% busy on average. At 12 a second that is about 1 million events a day. That was the load sent, not a limit. The test used v0.8.0; at that rate the disk fills first. <a href={doc('scale.md')}>How it was measured →</a></li>
        <li><strong>Stripe’s card fee</strong> on each payment (for example 2.9% + 30¢ for a US card; see <a href="https://stripe.com/pricing">stripe.com/pricing</a>), and Stripe Tax’s fee if you turn it on.</li>
        <li><strong>Your time to run it:</strong> one program plus Postgres and Redis. <a href={doc('self-host.md')}>What running it takes →</a></li>
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap prose">
      <h2>What Stripe Billing’s fee would be</h2>
      <p>Stripe Billing’s pay-as-you-go plan takes 0.7% of what you bill, on top of the card fee (<a href="https://stripe.com/billing/pricing">Stripe Billing pricing</a>). Hardcount uses Stripe to charge the card, and to work out tax if you turn on Stripe Tax.</p>
      <table>
        <thead><tr><th>You bill each month</th><th>Stripe Billing’s 0.7%</th><th>Each year</th></tr></thead>
        <tbody>
          {volumes.map((v) => <tr><td>{usd(v)}</td><td>{usd(v * 0.007)}</td><td>{usd(v * 0.007 * 12)}</td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <div class="wrap prose">
      <h2>Help</h2>
      <p>There is no paid support or hosted version. Help is best-effort from the maintainer, in <a href={START_HERE}>GitHub Discussions</a> or by <a href={`mailto:${CONTACT_EMAIL}`}>email</a>.</p>
      <p>Lock-in, what happens if the maintainer stops, and safety for real money: <a href="/faq/">FAQ →</a></p>
    </div>
  </section>

  <TryIt narrow />
</Base>

<style>
  .top { padding-top: 72px; }
  .lede { font-size: 20px; color: var(--ink-soft); }
  .plain { padding-left: 20px; }
  .plain li { margin-bottom: 12px; }
  table { border-collapse: collapse; width: 100%; max-width: 560px; font-size: 17px; }
  th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--rule); }
  th { font-weight: 600; }
</style>
